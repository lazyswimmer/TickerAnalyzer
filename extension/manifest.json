{
  "manifest_version": 3,
  "name": "Macro Risk Analyzer Lite",
  "version": "0.1.2",
  "description": "Highlight a stock ticker on any page and get an instant in-browser risk & quality score. No setup, no server.",
  "permissions": ["contextMenus", "scripting", "activeTab"],
  "host_permissions": [
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "https://fc.yahoo.com/*",
    "https://fred.stlouisfed.org/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Macro Risk Analyzer Lite",
    "default_popup": "popup.html"
  },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
}
